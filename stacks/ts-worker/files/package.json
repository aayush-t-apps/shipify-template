{
  "name": "{{APP_ID}}",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "{{APP_DESCRIPTION}}",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite build --mode development && wrangler dev --port 8787 --var APP_ENV:local",
    "dev:ui": "vite",
    "build": "vite build",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify": "pnpm verify:unit && pnpm test:e2e",
    "verify:unit": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm run --if-present check:app && pnpm build",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "dependencies": {
    "hono": "4.13.13",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@cloudflare/workers-types": "5.20261011.1",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  }
}
