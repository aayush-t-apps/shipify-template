# The Shipify contract. CI runs these targets and nothing else, so implement them for this project's
# language and host (AGENTS.md lists what each one receives). Required: setup check test build
# verify, and deploy for apps. Optional: dev audit format e2e preview rollback pause resume version.
.PHONY: setup check test build verify deploy

setup:
	@echo "make setup: nothing to set up yet."

check test build verify:
	@echo "make $@: not implemented yet. Implement it in the Makefile (see AGENTS.md)." >&2; exit 1
# #if IS_APP

deploy:
	@echo "make deploy: not implemented yet. Deploy SHIPIFY_SHA to SHIPIFY_ENV (see AGENTS.md)." >&2; exit 1
# #endif
