{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["@cloudflare/workers-types"],
    "resolveJsonModule": true
  },
  "include": [
    "src/worker",
    "src/shared",
    "tests/unit",
    "src/web/lib",
    "vitest.config.ts",
    "shipify.json"
  ]
}
