{
  "id": "/admin/chat/",
  "name": "Shipify",
  "short_name": "Shipify",
  "description": "Your Shipify tasks, and a chat to start one",
  "start_url": "/admin/chat/",
  "scope": "/admin/chat/",
  "display": "standalone",
  "background_color": "#f3f5f8",
  "theme_color": "#0c7c70",
  "icons": [
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icon-maskable.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/admin/chat/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "files", "accept": ["*/*"] }]
    }
  }
}
