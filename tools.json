{
  "version": 1,
  "notion": {
    "description": "Your Notion pages and databases: the ones connected to the Shipify integrations",
    "run": ["node_modules/.bin/tsx", "tools/notion/server.ts"],
    "keys": {
      "NOTION_TOKEN": {
        "look": "SHIPIFY_NOTION_READ",
        "act": "SHIPIFY_NOTION_WRITE"
      }
    },
    "look": ["search", "read_page", "read_database", "query_database"],
    "act": ["update_page", "create_page"],
    "args": {
      "update_page": {
        "target": "page",
        "warn": { "content": "replaces the page's whole body" }
      },
      "create_page": { "target": "parent" }
    },
    "check": ["node_modules/.bin/tsx", "tools/notion/server.ts", "--check"],
    "setup": {
      "needs": [
        "Two Notion integrations (notion.so/profile/integrations → New integration): one that can only read content, and one that can read, update and insert. Then share the pages Shipify may use with both (… → Connections)."
      ],
      "keys": {
        "SHIPIFY_NOTION_READ": {
          "ask": "the read-only integration's secret"
        },
        "SHIPIFY_NOTION_WRITE": {
          "ask": "the read-and-write integration's secret"
        }
      }
    }
  },
  "drop": {
    "description": "Your Drop: share files a task made as a drop and its link, change who may open it, and revoke it",
    "run": ["node_modules/.bin/tsx", "tools/drop/server.ts"],
    "keys": {
      "DROP_URL": {
        "look": "SHIPIFY_DROP_URL",
        "act": "SHIPIFY_DROP_URL"
      },
      "DROP_CLIENT_ID": {
        "look": "SHIPIFY_DROP_READ_ID",
        "act": "SHIPIFY_DROP_WRITE_ID"
      },
      "DROP_CLIENT_SECRET": {
        "look": "SHIPIFY_DROP_READ_SECRET",
        "act": "SHIPIFY_DROP_WRITE_SECRET"
      }
    },
    "look": ["list"],
    "act": ["publish", "update", "revoke"],
    "args": {
      "publish": {
        "required": ["title", "share"],
        "properties": {
          "title": {},
          "files": {},
          "share": {},
          "people": {},
          "expiry": {},
          "pin": {}
        },
        "files": "files"
      },
      "update": {
        "required": ["drop"],
        "properties": {
          "drop": {},
          "share": {},
          "people": {},
          "remove": {},
          "pin": {},
          "new_link": {}
        },
        "target": "drop",
        "warn": {
          "share": "a change may make a new link; me stops its link and every person's access",
          "new_link": "the old link stops at once",
          "pin": "true makes a new PIN, and the old one stops"
        }
      },
      "revoke": {
        "required": ["drop"],
        "properties": { "drop": {} },
        "target": "drop",
        "warn": { "drop": "deletes the drop and its files: its links stop at once" }
      }
    },
    "check": ["node_modules/.bin/tsx", "tools/drop/server.ts", "--check"],
    "setup": {
      "needs": [
        "Drop, live, with its Access app on /admin and /api (plans/drop.plan.md)",
        "Two Cloudflare Access service tokens (Zero Trust → Access → Service credentials → Create Service Token): one named Shipify Drop read, one Shipify Drop write. Add both to the /api app's policy, with the action Service Auth (docs/tools.md, Drop)."
      ],
      "keys": {
        "SHIPIFY_DROP_URL": {
          "ask": "Drop's address, like https://drop.app.example.com"
        },
        "SHIPIFY_DROP_READ_ID": {
          "ask": "the read token's Client ID"
        },
        "SHIPIFY_DROP_READ_SECRET": {
          "ask": "the read token's Client Secret"
        },
        "SHIPIFY_DROP_WRITE_ID": {
          "ask": "the write token's Client ID"
        },
        "SHIPIFY_DROP_WRITE_SECRET": {
          "ask": "the write token's Client Secret"
        }
      }
    }
  },
  "telegram": {
    "description": "Telegram: ask, remember, approve a list with a tap and get your links from your phone, through the edge (ADR 0031, ADR 0049)",
    "in": {
      "door": "telegram"
    },
    "check": ["node_modules/.bin/tsx", "tools/telegram/setup.ts", "--check"],
    "setup": {
      "needs": [
        "The edge's door App, set up (pnpm ship door setup --yes), and Cloudflare's deploy token in your credentials file",
        "A Telegram bot: in Telegram, open @BotFather, send /newbot, choose a name, and copy the token it gives you"
      ],
      "keys": {
        "TELEGRAM_TOKEN": {
          "ask": "the bot's token from @BotFather",
          "to": "edge"
        }
      },
      "steps": [
        {
          "say": "Check the token with Telegram",
          "run": ["node_modules/.bin/tsx", "tools/telegram/setup.ts", "token"]
        },
        {
          "say": "Give the edge Telegram's secret",
          "run": ["node_modules/.bin/tsx", "tools/telegram/setup.ts", "edge"]
        },
        {
          "say": "Point the bot at the edge, one update at a time: messages and taps",
          "run": ["node_modules/.bin/tsx", "tools/telegram/setup.ts", "webhook"]
        },
        {
          "say": "Set the bot's menu of four, its description and its photo",
          "run": ["node_modules/.bin/tsx", "tools/telegram/setup.ts", "menu"]
        },
        {
          "say": "Link you: open the link it shows, press Start, paste the id the bot sends",
          "run": ["node_modules/.bin/tsx", "tools/telegram/setup.ts", "link"]
        },
        {
          "say": "Send a test message to your phone",
          "run": ["node_modules/.bin/tsx", "tools/telegram/setup.ts", "test"]
        }
      ],
      "remove": ["node_modules/.bin/tsx", "tools/telegram/setup.ts", "--remove"]
    }
  },
  "webchat": {
    "description": "The web chat at shipify.<domain>/admin/chat: every task, threads, files, repeats, the notebook and the setup, from your phone or PC, through the door, with notifications when a reply comes (ADR 0036, ADR 0050)",
    "in": {
      "door": "web"
    },
    "check": ["node_modules/.bin/tsx", "tools/web/setup.ts", "--check"],
    "setup": {
      "needs": [
        "The status page, set up first (pnpm ship door page --yes), and Cloudflare's deploy token in your credentials file"
      ],
      "steps": [
        {
          "say": "Check the status page is set up",
          "run": ["node_modules/.bin/tsx", "tools/web/setup.ts", "page"]
        },
        {
          "say": "Check the sign-in covers the chat (Access path admin/*)",
          "run": ["node_modules/.bin/tsx", "tools/web/setup.ts", "signin"]
        },
        {
          "say": "Let your words in from the chat",
          "run": ["node_modules/.bin/tsx", "tools/web/setup.ts", "you"]
        },
        {
          "say": "Check file storage",
          "run": ["node_modules/.bin/tsx", "tools/web/setup.ts", "files"]
        },
        {
          "say": "Turn on notifications",
          "run": ["node_modules/.bin/tsx", "tools/web/setup.ts", "notify"]
        },
        {
          "say": "Open the chat",
          "run": ["node_modules/.bin/tsx", "tools/web/setup.ts", "open"]
        }
      ],
      "remove": ["node_modules/.bin/tsx", "tools/web/setup.ts", "--remove"]
    }
  }
}
